generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("TOURIST")
  avatar       String?
  bio          String?
  preferences  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities Activity[] @relation("OperatorActivities")

  bookings  Booking[]
  favorites Favorite[]
  reviews   Review[]
  trips     Trip[]

  @@map("users")
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  country     String
  description String
  coverImage  String
  latitude    Float
  longitude   Float
  highlights  String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  activities Activity[]
  trips      Trip[]

  @@map("destinations")
}

model Activity {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String
  price        Float
  currency     String   @default("EUR")
  duration     Int
  difficulty   String?
  maxGroupSize Int      @default(20)
  images       String
  latitude     Float
  longitude    Float
  included     String?
  highlights   String?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  featured     Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  operatorId String
  operator   User   @relation("OperatorActivities", fields: [operatorId], references: [id])

  timeSlots      TimeSlot[]
  bookings       Booking[]
  favorites      Favorite[]
  reviews        Review[]
  tripActivities TripActivity[]

  @@index([destinationId])
  @@index([operatorId])
  @@index([category])
  @@index([status])
  @@map("activities")
}

model TimeSlot {
  id          String   @id @default(cuid())
  date        DateTime
  startTime   String
  endTime     String
  capacity    Int
  bookedCount Int      @default(0)
  status      String   @default("AVAILABLE")

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([activityId])
  @@index([date])
  @@map("time_slots")
}

model Booking {
  id           String   @id @default(cuid())
  participants Int
  totalPrice   Float
  status       String   @default("CONFIRMED")
  notes        String?
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  timeSlotId String
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  review Review?

  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@map("bookings")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  @@unique([userId, activityId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@index([activityId])
  @@map("reviews")
}

model Trip {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  budget      Float?
  status      String   @default("PLANNING")
  preferences String?
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  activities TripActivity[]

  @@index([userId])
  @@map("trips")
}

model TripActivity {
  id            String  @id @default(cuid())
  dayNumber     Int
  orderIndex    Int
  startTime     String?
  notes         String?
  timeOfDay     String?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  @@index([tripId])
  @@map("trip_activities")
}
